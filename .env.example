# Google API Configuration
# Download your service account key from Google Cloud Console
# and save it as credentials.json in the project root
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials.json

# Or use OAuth2 credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Google Sheets
SHEET_ID=18HVul32CS-w1XYYXkBbGbbswdIzlnQs3NcQ05KkTm3E

# Email — Option A: Gmail with App Password (recommended)
# 1. Enable 2FA on your Google account
# 2. Go to myaccount.google.com > Security > App Passwords
# 3. Generate an app password for "Mail"
GMAIL_USER=ac@arkeoconstruction.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
GMAIL_FROM=ac@arkeoconstruction.com
RECIPIENT_EMAIL=ac@arkeoconstruction.com

# Email — Option B: Generic SMTP (SendGrid, Mailgun, Office 365, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password_here
# SMTP_FROM=ac@arkeoconstruction.com

# Google Calendar (optional)
CALENDAR_ID=primary

# Local database path (defaults to ./db.json)
DB_PATH=./db.json

# Server
PORT=3000
NODE_ENV=production
