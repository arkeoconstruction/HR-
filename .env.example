# ─── Google API Configuration ─────────────────────────────────────────────────
# Download your service account key from Google Cloud Console
# and save it as credentials.json in the project root.
# If credentials.json is absent, the app falls back to local db.json storage.
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials.json

# Or use OAuth2 credentials (alternative to service account)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
SHEET_ID=18HVul32CS-w1XYYXkBbGbbswdIzlnQs3NcQ05KkTm3E

# ─── Gmail API (primary email transport) ─────────────────────────────────────
RECIPIENT_EMAIL=ac@arkeoconstruction.com
GMAIL_FROM=ac@arkeoconstruction.com

# ─── SMTP / Nodemailer (fallback email transport) ─────────────────────────────
# Used automatically when Gmail API is unavailable or credentials are missing.
# Example: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ─── Google Calendar ──────────────────────────────────────────────────────────
CALENDAR_ID=primary

# ─── Local JSON Database ──────────────────────────────────────────────────────
# Path to local db.json file (used as fallback when Google Sheets is unavailable)
# DB_PATH=./db.json

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
